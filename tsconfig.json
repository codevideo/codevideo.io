{
  "include": ["./src/**/*", "wrap-with-provider.jsx"],
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "lib": ["dom", "es2017"],
    "jsx": "react",
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noEmit": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "paths": {
      "@fullstackcraftllc/growthkit/coupons": ["./node_modules/@fullstackcraftllc/growthkit/dist/coupons.d.ts"]
    },
    "resolveJsonModule": true
  }
}
